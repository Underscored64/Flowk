# --- Server ---
DOMAIN=:80
APP_URL=http://localhost:3000
DB_PASSWORD=change-me-long-random
# local dev only (docker-compose overrides it on the server)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
SESSION_SECRET=change-me-64-random-chars

# --- AI (Vultr Serverless Inference, OpenAI-compatible) ---
AI_ENABLED=true
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# --- Video (Jitsi as a Service, optional: fallback = meet.jit.si in a new tab) ---
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY_B64=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
